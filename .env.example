# ==============================================================================
# smart-cs-agent 环境变量配置模版
# 使用说明：复制本文件为 .env 并填入真实配置，严禁将 .env 提交至公开代码仓库
# ==============================================================================

# 大模型 Provider 选择（v2.0 新增，默认 deepseek；OpenAI 兼容厂商如通义/豆包同样用 deepseek 适配器，改下方 BASE_URL/MODEL 即可）
LLM_PROVIDER=deepseek

# 大模型 API Key（必填：推荐配置 DeepSeek 官方 API 或兼容 OpenAI 协议的厂商）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 兼容配置项（若设置了上方 DEEPSEEK_*，下方可留空；优先读取 DEEPSEEK_*）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL_NAME=deepseek-chat

# v2.0 P2 在线 Embedding 配置（可选：留空时自动降级为纯 BM25 检索，不阻塞启动）
# 兼容硅基流动（BAAI/bge-m3）、阿里云百炼（text-embedding-v3）或 OpenAI Embedding 接口
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# v2.0 P4-A/B Hybrid RAG Pre-RRF 双路原生门控与尾部裁剪阈值（基于 BAAI/bge-m3 40 题分布校准）
BM25_MIN_SCORE=3.0
BM25_MIN_RATIO=0.50
VECTOR_MIN_SIMILARITY=0.58
VECTOR_MAX_DROP=0.10
RRF_SINGLE_PATH_RATIO=0.60

# SQLite 数据库持久化路径（容器部署时默认挂载于 /app/data/smart_cs.db）
SQLITE_DB_PATH=./data/smart_cs.db

# 接口防刷限流（对话单 IP 每分钟上限默认 15；普通读/写业务接口默认 60/20）
RATE_LIMIT_PER_MINUTE=15
API_READ_RATE_LIMIT_PER_MINUTE=60
API_WRITE_RATE_LIMIT_PER_MINUTE=20

# 公网演示数据重置双层保护：配置口令时强制 X-Demo-Admin-Token 校验；留空时按单 IP 冷却（默认 300 秒/次）
DEMO_ADMIN_TOKEN=
DEMO_RESET_COOLDOWN_SECONDS=300

# v2.0 P1 运行态护栏：单轮最大推理/工具步数、单步超时（秒）、整轮总超时（秒）
MAX_STEPS=5
STEP_TIMEOUT_SEC=20
TURN_TIMEOUT_SEC=45

# 公网演示每日 API 总额度（按北京时间每日 00:00 自动重置，超出熔断抛出 429，默认 200）
DAILY_CHAT_LIMIT=200

# 自动化并发评测服务目标地址（运行 eval/run_eval.py 时选用）
EVAL_BASE_URL=http://127.0.0.1:8000
